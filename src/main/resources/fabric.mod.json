	"authors": ["Voltworks Team"],
	"license": "MIT",
	"icon": "assets/voltworks_quarry/icon.png",
	"contact": {
		"homepage": "https://github.com/chrisbrady86/voltworks-quarry",
		"sources": "https://github.com/chrisbrady86/voltworks-quarry",
		"issues": "https://github.com/chrisbrady86/voltworks-quarry/issues"
	},
	"environment": "*",
	"entrypoints": {
		"main": ["dev.voltworks.quarry.VoltworksQuarry"],
		"client": ["dev.voltworks.quarry.client.VoltworksQuarryClient"],
